{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solemi-sleep-sync-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://solemi-sleep-internal.pages.dev,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solemi-sleep-db-staging",
      "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID"
    }
  ]
}
