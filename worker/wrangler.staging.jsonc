{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solemi-sleep-sync-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SOLEMI_ENVIRONMENT": "staging",
    "ALLOWED_ORIGINS": "https://solemi-sleep-internal.pages.dev,http://localhost:5173",
    "GOOGLE_CLIENT_ID": "637253731977-hfds5vtk53nqlkc9vul67m78sckqpsc9.apps.googleusercontent.com",
    "ACCOUNT_FAMILY_BRIDGE": "true",
    "ENTITLEMENT_ENFORCEMENT": "true",
    "ENTITLEMENT_TEST_MODE": "true",
    "RECONCILIATION_CONFLICTS": "true"
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "19200",
      "simple": {
        "limit": 6000,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "19201",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "INVITE_LIMITER",
      "namespace_id": "19202",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solemi-sleep-db-staging",
      "database_id": "1fdd9f64-ea4b-4499-9b6e-636462d51d37"
    }
  ]
}
