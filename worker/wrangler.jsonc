{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solemi-sleep-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "SOLEMI_ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://czkiii.github.io,http://localhost:5173"
  },
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "19100",
      "simple": {
        "limit": 6000,
        "period": 60
      }
    },
    {
      "name": "AUTH_LIMITER",
      "namespace_id": "19101",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "INVITE_LIMITER",
      "namespace_id": "19102",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "limits": { "cpu_ms": 50 },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solemi-sleep-db",
      "database_id": "8ace71f6-9c2d-445f-8788-a76bedcdd7bc"
    }
  ]
}
