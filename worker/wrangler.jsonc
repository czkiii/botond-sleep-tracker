{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solemi-sleep-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://czkiii.github.io,http://localhost:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solemi-sleep-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}
