{
  "name": "solemi-sleep",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "check:repository": "node scripts/check-repository-hygiene.mjs",
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pdf": "node scripts/check-pdf-export.mjs",
    "test:pwa": "node scripts/check-pwa-lifecycle.mjs",
    "test:account-access": "node scripts/check-account-access.mjs",
    "test:account-deletion": "node scripts/check-account-deletion.mjs",
    "test:recovery": "vitest run worker/tests/d1Restore.test.ts worker/tests/businessRestore.test.ts worker/tests/deletionRestore.test.ts worker/tests/retention.test.ts worker/tests/retainedFiles.test.ts worker/tests/accountDeletion.test.ts worker/tests/retentionRehearsal.test.ts",
    "test:security": "node scripts/check-security-headers.mjs",
    "test:family-join": "node scripts/check-family-bootstrap.mjs",
    "test:child-deletion": "node scripts/check-child-deletion.mjs",
    "test:settings": "node scripts/check-settings-accessibility.mjs",
    "test:conflicts": "node scripts/check-conflict-accessibility.mjs",
    "test:basic-statistics": "node scripts/check-basic-statistics.mjs",
    "test:statistics": "node scripts/check-statistics-performance.mjs",
    "preview": "vite preview",
    "postinstall": "node scripts/patch-native-purchases.mjs",
    "build:native": "vite build --mode native",
    "native:sync": "node scripts/patch-native-purchases.mjs && npm run build:native && cap sync",
    "native:android": "cap open android",
    "native:ios": "cap open ios",
    "test:native": "vitest run src/nativeBilling.test.ts src/nativeBillingRuntime.test.ts src/releaseConfiguration.test.ts --exclude **/.private-backups/**"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0",
    "@capgo/native-purchases": "8.9.6",
    "@pdf-lib/fontkit": "1.1.1",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "recharts": "3.1.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.0.3",
    "vitest": "4.1.12"
  }
}
